{
  "name": "@repo/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "predev:e2e": "pnpm test:prepare",
    "dev:e2e": "cross-env NODE_ENV=test DB_TEST_KIND=e2e PORT=3001 nest start",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint src scripts",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:prepare": "pnpm --filter @repo/contracts build",
    "pretest:unit": "pnpm test:prepare",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "pretest:unit:watch": "pnpm test:prepare",
    "test:unit:watch": "vitest --config vitest.unit.config.ts",
    "pretest:unit:coverage": "pnpm test:prepare",
    "test:unit:coverage": "vitest run --coverage --config vitest.unit.config.ts",
    "pretest:integration": "pnpm test:prepare",
    "test:integration": "cross-env NODE_ENV=test DB_TEST_KIND=integration vitest run --config vitest.integration.config.ts",
    "pretest:integration:watch": "pnpm test:prepare",
    "test:integration:watch": "cross-env NODE_ENV=test DB_TEST_KIND=integration vitest --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:test:reset": "cross-env NODE_ENV=test DB_TEST_KIND=integration tsx scripts/reset-test-db.ts",
    "db:e2e:reset": "cross-env NODE_ENV=test DB_TEST_KIND=e2e tsx scripts/reset-test-db.ts --seed",
    "pretest:integration:coverage": "pnpm test:prepare",
    "test:integration:coverage": "cross-env NODE_ENV=test DB_TEST_KIND=integration vitest run --coverage --config vitest.integration.config.ts",
    "pretest:watch": "pnpm test:prepare",
    "test:watch": "vitest --config vitest.unit.config.ts"
  },
  "dependencies": {
    "@repo/contracts": "workspace:*",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "drizzle-orm": "0.45.2",
    "dotenv": "^17.2.0",
    "helmet": "^8.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.6.1",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@nestjs/testing": "12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "oxlint": "1.82.0",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "6.0.2",
    "vitest": "5.0.0",
    "@nestjs/cli": "12.0.0",
    "@types/pg": "^8.15.0"
  }
}
