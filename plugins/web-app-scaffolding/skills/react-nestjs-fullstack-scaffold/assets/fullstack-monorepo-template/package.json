{
  "name": "fullstack-monorepo-template",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "pnpm --filter @repo/contracts build",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint && oxlint tests playwright.config.ts vitest.architecture.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm test:architecture && pnpm test:unit && pnpm test:integration",
    "test:unit": "turbo run test:unit",
    "test:unit:coverage": "turbo run test:unit:coverage",
    "test:integration": "turbo run test:integration",
    "test:e2e:prepare": "pnpm --filter @repo/api db:e2e:reset",
    "test:e2e": "pnpm test:e2e:prepare && playwright test",
    "test:e2e:chromium": "pnpm test:e2e:prepare && playwright test --project=chromium",
    "test:e2e:headed": "pnpm test:e2e:prepare && playwright test --headed",
    "test:e2e:ui": "pnpm test:e2e:prepare && playwright test --ui",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:scaffold",
    "verify:all": "pnpm verify && pnpm test:e2e",
    "db:generate": "pnpm --filter @repo/api db:generate",
    "db:check": "pnpm --filter @repo/api db:check",
    "db:migrate": "pnpm --filter @repo/api db:migrate",
    "db:seed": "pnpm --filter @repo/api db:seed",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "test:web": "pnpm --filter @repo/web test:unit && pnpm --filter @repo/ui test:unit && pnpm --filter @repo/i18n test:unit",
    "test:api": "pnpm --filter @repo/api test",
    "test:contracts": "pnpm --filter @repo/contracts test:unit",
    "test:e2e:debug": "pnpm test:e2e:prepare && playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:ci": "pnpm verify && pnpm test:e2e:chromium",
    "test:coverage": "pnpm test:unit:coverage && pnpm test:integration:coverage",
    "test:integration:coverage": "pnpm --filter @repo/api test:integration:coverage",
    "test:e2e:firefox": "pnpm test:e2e:prepare && playwright test --project=firefox",
    "test:e2e:webkit": "pnpm test:e2e:prepare && playwright test --project=webkit",
    "test:e2e:list": "playwright test --list",
    "test:e2e:install": "playwright install chromium firefox webkit",
    "test:e2e:install:deps": "playwright install --with-deps chromium firefox webkit",
    "test:architecture": "vitest run --config vitest.architecture.config.ts",
    "scaffold:init": "node scripts/init-project.mjs",
    "test:scaffold": "node --test scripts/init-project.test.mjs",
    "db:prune-rate-limits": "pnpm --filter @repo/api db:prune-rate-limits"
  },
  "devDependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/testing": "12.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "7.2.1",
    "drizzle-orm": "0.45.2",
    "oxlint": "1.82.0",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "turbo": "2.10.12",
    "vitest": "5.0.0"
  },
  "type": "module"
}
