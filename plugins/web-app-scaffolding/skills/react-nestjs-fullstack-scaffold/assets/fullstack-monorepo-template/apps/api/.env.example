NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://app:app@127.0.0.1:5432/fullstack_dev
TEST_DATABASE_URL=postgresql://app:app@127.0.0.1:5432/fullstack_integration_test
E2E_DATABASE_URL=postgresql://app:app@127.0.0.1:5432/fullstack_e2e_test
REDIS_URL=redis://127.0.0.1:6379/0
TEST_REDIS_URL=redis://127.0.0.1:6379/14
E2E_REDIS_URL=redis://127.0.0.1:6379/15
SESSION_TTL_HOURS=168

# Optional: explicit IP allowlist of trusted reverse proxies (never trust arbitrary X-Forwarded-For)
TRUSTED_PROXY_IPS=
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=15000
